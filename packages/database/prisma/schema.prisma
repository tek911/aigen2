// Arena Debate Platform - Complete Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Nullable for OAuth users
  avatar        String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Game Stats
  eloRating         Int      @default(1200)
  credibilityScore  Float    @default(50.0)
  level             Int      @default(1)
  xp                Int      @default(0)
  totalDebates      Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  draws             Int      @default(0)
  mindChanges       Int      @default(0) // Times changed position
  debateStyle       DebateStyle @default(BALANCED)

  // Streak tracking
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastDebateDate    DateTime?

  // Relations
  accounts          Account[]
  sessions          Session[]
  debates           DebateParticipant[]
  arguments         Argument[]
  votes             Vote[]
  achievements      UserAchievement[]
  badges            UserBadge[]
  stances           UserStance[]
  campMemberships   CampMember[]
  reports           Report[]
  notifications     Notification[]
  issuedChallenges  Challenge[] @relation("challenger")
  receivedChallenges Challenge[] @relation("challenged")
  evidenceSubmissions Evidence[]

  // Moderation
  isBanned          Boolean  @default(false)
  isShadowBanned    Boolean  @default(false)
  banReason         String?
  banExpiresAt      DateTime?

  @@index([eloRating])
  @@index([credibilityScore])
  @@index([username])
}

enum DebateStyle {
  ANALYTICAL
  EMOTIONAL
  BALANCED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// TOPICS & CAMPS
// ============================================================================

model Topic {
  id              String   @id @default(cuid())
  title           String   @unique
  slug            String   @unique
  description     String
  category        Category
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Engagement metrics
  heat            Float    @default(0.0) // Activity score
  trendingScore   Float    @default(0.0)
  totalDebates    Int      @default(0)
  totalViews      Int      @default(0)

  // Relations
  debates         Debate[]
  camps           Camp[]
  stances         UserStance[]
  evidence        Evidence[]

  @@index([category])
  @@index([trendingScore])
  @@index([heat])
}

enum Category {
  POLITICS
  TECHNOLOGY
  PHILOSOPHY
  SCIENCE
  ETHICS
  ECONOMICS
  SOCIAL_ISSUES
  ENVIRONMENT
  EDUCATION
  HEALTH
  CULTURE
  SPORTS
  OTHER
}

model Camp {
  id              String   @id @default(cuid())
  topicId         String
  position        String   // e.g., "Pro-Choice", "Pro-Life"
  description     String?
  createdAt       DateTime @default(now())

  // Relations
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  members         CampMember[]
  resources       CampResource[]
  strategies      DebateStrategy[]

  // Stats
  memberCount     Int      @default(0)
  winRate         Float    @default(0.0)

  @@index([topicId])
  @@unique([topicId, position])
}

model CampMember {
  id              String   @id @default(cuid())
  userId          String
  campId          String
  joinedAt        DateTime @default(now())
  isChampion      Boolean  @default(false)
  contributionScore Int    @default(0)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  camp            Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@unique([userId, campId])
  @@index([campId])
}

model CampResource {
  id              String   @id @default(cuid())
  campId          String
  title           String
  url             String
  description     String?
  createdAt       DateTime @default(now())
  upvotes         Int      @default(0)

  camp            Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@index([campId])
}

model DebateStrategy {
  id              String   @id @default(cuid())
  campId          String
  title           String
  content         String
  effectiveness   Float    @default(0.0)
  createdAt       DateTime @default(now())

  camp            Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@index([campId])
}

model UserStance {
  id              String   @id @default(cuid())
  userId          String
  topicId         String
  position        String
  confidence      Int      @default(5) // 1-10 scale
  changedAt       DateTime @default(now())
  previousPosition String?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId])
}

// ============================================================================
// DEBATES
// ============================================================================

model Debate {
  id              String   @id @default(cuid())
  topicId         String
  format          DebateFormat
  status          DebateStatus
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?

  // Settings
  turnDuration    Int      // seconds
  maxTurns        Int
  isPublic        Boolean  @default(true)
  allowSpectators Boolean  @default(true)

  // Engagement
  viewCount       Int      @default(0)
  shareCount      Int      @default(0)

  // Results
  winnerId        String?
  winMethod       WinMethod?

  // Relations
  topic           Topic    @relation(fields: [topicId], references: [id])
  participants    DebateParticipant[]
  arguments       Argument[]
  votes           Vote[]
  aiAnalysis      AIAnalysis?
  highlights      DebateHighlight[]

  @@index([topicId])
  @@index([status])
  @@index([createdAt])
  @@index([format])
}

enum DebateFormat {
  LIGHTNING       // 5 minutes, 30-second turns
  STANDARD        // 30 minutes, 2-minute turns
  DEEP_DIVE       // 7 days, daily exchanges
  TEAM_BATTLE     // 3v3, coordinated arguments
}

enum DebateStatus {
  CHALLENGE_ISSUED
  ACCEPTED
  PREPARATION
  ACTIVE
  VOTING
  COMPLETED
  CANCELLED
}

enum WinMethod {
  PEER_VOTE
  AI_DECISION
  FORFEIT
  TIMEOUT
  CONSENSUS
}

model DebateParticipant {
  id              String   @id @default(cuid())
  debateId        String
  userId          String
  position        String   // Their stance
  joinedAt        DateTime @default(now())
  isReady         Boolean  @default(false)

  // Performance in this debate
  argumentCount   Int      @default(0)
  qualityScore    Float    @default(0.0)
  votesReceived   Int      @default(0)

  debate          Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([debateId, userId])
  @@index([debateId])
  @@index([userId])
}

model Argument {
  id              String   @id @default(cuid())
  debateId        String
  userId          String
  content         String
  turnNumber      Int
  createdAt       DateTime @default(now())

  // Analysis
  qualityScore    Float?
  toxicityScore   Float?
  hasFallacies    Boolean  @default(false)
  fallacies       String[] // Array of detected fallacies

  // Engagement
  upvotes         Int      @default(0)
  highlights      Int      @default(0)

  // Relations
  debate          Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources         ArgumentSource[]
  reactions       ArgumentReaction[]

  @@index([debateId])
  @@index([userId])
  @@index([turnNumber])
}

model ArgumentSource {
  id              String   @id @default(cuid())
  argumentId      String
  url             String
  title           String?
  credibilityScore Float?
  verifiedAt      DateTime?

  argument        Argument @relation(fields: [argumentId], references: [id], onDelete: Cascade)

  @@index([argumentId])
}

model ArgumentReaction {
  id              String   @id @default(cuid())
  argumentId      String
  reactionType    String   // e.g., "fire", "thinking", "mindblown"
  count           Int      @default(0)

  argument        Argument @relation(fields: [argumentId], references: [id], onDelete: Cascade)

  @@unique([argumentId, reactionType])
}

model Challenge {
  id              String   @id @default(cuid())
  challengerId    String
  challengedId    String
  topicId         String?
  format          DebateFormat
  message         String?
  status          ChallengeStatus
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  respondedAt     DateTime?

  challenger      User     @relation("challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged      User     @relation("challenged", fields: [challengedId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([challengedId])
  @@index([status])
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

// ============================================================================
// VOTING & ANALYSIS
// ============================================================================

model Vote {
  id              String   @id @default(cuid())
  debateId        String
  voterId         String
  winnerId        String?  // The participant they think won
  createdAt       DateTime @default(now())

  // Multi-dimensional voting
  bestArgument    String?  // Argument ID
  bestSources     String?  // User ID
  mostRespectful  String?  // User ID
  changedMyMind   Boolean  @default(false)
  reasoning       String?

  debate          Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  voter           User     @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([debateId, voterId])
  @@index([debateId])
}

model AIAnalysis {
  id              String   @id @default(cuid())
  debateId        String   @unique
  createdAt       DateTime @default(now())

  // Overall analysis
  summary         String
  winnerId        String?
  confidence      Float

  // Detailed scoring
  argumentStructure Json   // Scores for each participant
  evidenceQuality   Json
  rhetoricEffectiveness Json
  logicalConsistency Json

  // Insights
  commonGround    String[] // Areas of agreement
  keyDisagreements String[]
  suggestions     String[] // Educational feedback

  debate          Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
}

model DebateHighlight {
  id              String   @id @default(cuid())
  debateId        String
  title           String
  description     String
  startTime       DateTime
  endTime         DateTime
  viewCount       Int      @default(0)
  shareCount      Int      @default(0)

  debate          Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([debateId])
}

// ============================================================================
// EVIDENCE & FACT CHECKING
// ============================================================================

model Evidence {
  id              String   @id @default(cuid())
  topicId         String
  submittedBy     String
  url             String
  title           String
  description     String?
  sourceType      SourceType
  credibilityScore Float   @default(0.0)
  verifiedBy      String[] // User IDs who verified
  usageCount      Int      @default(0)
  createdAt       DateTime @default(now())

  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  submitter       User     @relation(fields: [submittedBy], references: [id])

  @@index([topicId])
  @@index([credibilityScore])
}

enum SourceType {
  ACADEMIC_PAPER
  NEWS_ARTICLE
  GOVERNMENT_DATA
  EXPERT_OPINION
  STATISTICAL_DATA
  VIDEO
  BOOK
  OTHER
}

model FactCheck {
  id              String   @id @default(cuid())
  claim           String
  verdict         FactCheckVerdict
  explanation     String
  sources         String[] // URLs
  createdAt       DateTime @default(now())
  expiresAt       DateTime // Fact checks can become outdated

  @@index([createdAt])
}

enum FactCheckVerdict {
  TRUE
  MOSTLY_TRUE
  PARTLY_TRUE
  MOSTLY_FALSE
  FALSE
  UNVERIFIABLE
}

// ============================================================================
// GAMIFICATION
// ============================================================================

model Achievement {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String
  icon            String
  xpReward        Int
  tier            AchievementTier
  requirement     Json     // Flexible requirement structure

  users           UserAchievement[]
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model UserAchievement {
  id              String   @id @default(cuid())
  userId          String
  achievementId   String
  unlockedAt      DateTime @default(now())
  progress        Float    @default(100.0) // Percentage

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement     Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

model Badge {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String
  icon            String
  rarity          BadgeRarity

  users           UserBadge[]
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model UserBadge {
  id              String   @id @default(cuid())
  userId          String
  badgeId         String
  earnedAt        DateTime @default(now())
  isEquipped      Boolean  @default(false)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge           Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
}

model DailyChallenge {
  id              String   @id @default(cuid())
  date            DateTime @unique
  challengeType   String
  requirement     Json
  xpReward        Int

  completions     DailyChallengeCompletion[]
}

model DailyChallengeCompletion {
  id              String   @id @default(cuid())
  userId          String
  challengeId     String
  completedAt     DateTime @default(now())

  challenge       DailyChallenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
  @@index([userId])
}

model Leaderboard {
  id              String   @id @default(cuid())
  userId          String
  period          LeaderboardPeriod
  category        String   // "global", "topic:123", "region:US"
  rank            Int
  score           Float
  updatedAt       DateTime @updatedAt

  @@unique([userId, period, category])
  @@index([period, category, rank])
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  SEASONAL
  ALL_TIME
}

// ============================================================================
// NOTIFICATIONS & COMMUNICATION
// ============================================================================

model Notification {
  id              String   @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  message         String
  data            Json?    // Additional data for the notification
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  CHALLENGE_RECEIVED
  CHALLENGE_ACCEPTED
  DEBATE_STARTING
  YOUR_TURN
  DEBATE_COMPLETED
  ACHIEVEMENT_UNLOCKED
  BADGE_EARNED
  LEVEL_UP
  NEW_FOLLOWER
  MENTION
  VOTE_RECEIVED
  LEADERBOARD_CHANGE
}

// ============================================================================
// MODERATION
// ============================================================================

model Report {
  id              String   @id @default(cuid())
  reporterId      String
  reportedType    String   // "user", "argument", "debate"
  reportedId      String
  reason          ReportReason
  description     String?
  status          ReportStatus @default(PENDING)
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?
  resolution      String?

  reporter        User     @relation(fields: [reporterId], references: [id])

  @@index([status])
  @@index([reportedType, reportedId])
}

enum ReportReason {
  TOXICITY
  HARASSMENT
  SPAM
  MISINFORMATION
  OFF_TOPIC
  INAPPROPRIATE_CONTENT
  BOT_BEHAVIOR
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// ============================================================================
// ANALYTICS & TRACKING
// ============================================================================

model UserAnalytics {
  id              String   @id @default(cuid())
  userId          String   @unique

  // Performance trends
  eloHistory      Json     // Time-series data
  winRateHistory  Json

  // Behavior patterns
  activeHours     Json     // Hour distribution
  preferredTopics String[]
  averageDebateLength Int

  // Engagement
  totalTimeDebating Int    // seconds
  totalArguments    Int
  totalVotes        Int
  totalViews        Int

  updatedAt       DateTime @updatedAt
}

model SystemMetrics {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())

  activeUsers     Int
  activeDebates   Int
  totalDebates    Int
  avgResponseTime Float
  errorRate       Float

  @@index([timestamp])
}
